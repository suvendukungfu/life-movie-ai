# ==========================================
# LIFE MOVIE — Git Ignore Rules
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Next.js Build Output & Cache
/.next/
/out/
/build
/dist
/generated
*.tsbuildinfo
next-env.d.ts

# SQLite Database & Write-Ahead Logs
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# Media Storage & Binary Assets
/.storage/
/storage/
/.data/
/scratch/
!lib/storage/
!app/api/storage/

# Test & Coverage Outputs
/coverage
*.lcov
test-results/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Deployment Artifacts
.vercel

# Operating System & Editor Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.env*.local
