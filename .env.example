# ==============================================================================
# LIFE MOVIE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for local development.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Prisma / SQLite)
# ------------------------------------------------------------------------------
# Local SQLite file database path (relative to prisma directory)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify JWT session cookies (min 32 chars)
AUTH_SECRET="replace-with-a-secure-random-32-char-string-for-jwt-signing"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Story Engine
# ------------------------------------------------------------------------------
# Google Gemini API key used for structured 5-act screenplay and logline generation
# Get an API key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 4. Cinema Rendering Engine (FFmpeg & FFprobe)
# ------------------------------------------------------------------------------
# Optional: Override paths to FFmpeg/FFprobe binaries if not available in standard system PATH
# FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
# FFPROBE_PATH="/opt/homebrew/bin/ffprobe"

# ------------------------------------------------------------------------------
# 5. Application Server Settings
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"
